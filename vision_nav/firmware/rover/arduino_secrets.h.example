#pragma once
// Copy to arduino_secrets.h (git-ignored) and fill in.
// Wi-Fi network for the robot to join (2.4 GHz only - e.g. a phone hotspot).
// Leave STA_SSID empty to always run as its own access point "RobotCar".
#define STA_SSID ""
#define STA_PASS ""

// vision-nav server (the robot connects out to it). Leave SERVER_HOST empty to disable.
#define SERVER_HOST "coolrover.online"
#define SERVER_PORT 9000
#define ROBOT_TOKEN ""   // ROBOT_TOKEN from the server's server/.env
