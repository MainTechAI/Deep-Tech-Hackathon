#pragma once

// Copy this file to secrets.h and replace every value before uploading.
// Keep the values ASCII-only for the first hardware test.
#define WAYFINDER_WIFI_SSID "WAYFINDER_PLAYER"
#define WAYFINDER_WIFI_PASSWORD "CHANGE_ME"

// The IPv4 address of the laptop running local_gateway_plain.py while it is
// connected to the SAME Android/iPhone hotspot as the rover.
#define WAYFINDER_BACKEND_HOST "192.168.1.100"
#define WAYFINDER_BACKEND_PORT 8000

// Optional one-metre Wi-Fi calibration defaults. In Serial Monitor, put the
// rover 1 m from the target hotspot and send c. Copy the reported result here
// if you want to keep the calibration after a restart.
#define WAYFINDER_RSSI_AT_ONE_METRE -45.0f
#define WAYFINDER_PATH_LOSS_N 2.5f
#define WAYFINDER_RSSI_CALIBRATED 0
